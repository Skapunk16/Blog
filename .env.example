# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ========================================================
# VARIABLES DE ENTORNO PARA DESPLIEGUE EN VERCEL & SUPABASE
# Configura estas variables en Vercel Dashboard -> Settings -> Environment Variables
# ========================================================

# Supabase Project URL (desde Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL="https://tu-proyecto.supabase.co"
SUPABASE_URL="https://tu-proyecto.supabase.co"

# Supabase Anon Public Key (desde Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Supabase Service Role Key (Opcional para operaciones administrativas de backend en Vercel)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Credenciales de Administrador para el panel del blog en Vercel
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin"
ADMIN_SECRET_TOKEN="tu-secreto-seguro-para-tokens-de-sesion"
